# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/plumberagent?schema=public"

# Anthropic API key for triage + bid parsing
ANTHROPIC_API_KEY="sk-ant-..."

# Model used for classification / extraction.
# Default is Opus 4.8 (most capable). For this high-volume, latency-sensitive
# triage path you may prefer a faster/cheaper tier — e.g. claude-haiku-4-5 —
# by overriding here. That's a cost/latency decision, so it's left to you.
ANTHROPIC_MODEL="claude-opus-4-8"

# Server
PORT=3000
